<Window x:Class="SpotifySynesthesia.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Spotify Synesthesia"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#070809"
        Loaded="HandleLoaded">
  <Grid>
    <wv2:WebView2 x:Name="Visualizer" DefaultBackgroundColor="#070809" />
    <Border x:Name="StartupStatus"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="24,18"
            Background="#111314"
            BorderBrush="#323536"
            BorderThickness="1"
            CornerRadius="6">
      <StackPanel>
        <TextBlock x:Name="StartupTitle"
                   HorizontalAlignment="Center"
                   Foreground="#F4F1EB"
                   FontFamily="Segoe UI Semibold"
                   FontSize="17"
                   Text="Opening Spotify Synesthesia" />
        <TextBlock x:Name="StartupDetail"
                   MaxWidth="480"
                   Margin="0,7,0,0"
                   HorizontalAlignment="Center"
                   Foreground="#AAA69F"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Text="Preparing the visual environment"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
