<Window x:Class="SpotifySynesthesia.Desktop.LastFmSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Last.fm metadata"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#161819">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Foreground="#F4F1EB"
               FontFamily="Segoe UI Semibold"
               FontSize="19"
               Text="Last.fm metadata" />
    <TextBlock Grid.Row="1"
               Margin="0,8,0,18"
               Foreground="#AAA69F"
               FontFamily="Segoe UI"
               FontSize="12"
               Text="Enter a Last.fm API key. The existing key is never displayed."
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="2">
      <TextBlock Margin="0,0,0,7"
                 Foreground="#C8C4BC"
                 FontFamily="Segoe UI"
                 FontSize="12"
                 Text="API key" />
      <PasswordBox x:Name="ApiKeyBox"
                   Height="38"
                   Padding="9,7"
                   BorderBrush="#484B4C"
                   Background="#27292A"
                   Foreground="#F3F0E9"
                   MaxLength="256" />
      <TextBlock x:Name="ValidationMessage"
                 MinHeight="18"
                 Margin="0,7,0,0"
                 Foreground="#D8AB5A"
                 FontFamily="Segoe UI"
                 FontSize="11" />
    </StackPanel>
    <Grid Grid.Row="4" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="RemoveButton"
              MinWidth="76"
              Height="34"
              Padding="12,5"
              Click="HandleRemove"
              Content="Remove" />
      <Button Grid.Column="2"
              MinWidth="76"
              Height="34"
              Margin="0,0,8,0"
              Padding="12,5"
              IsCancel="True"
              Content="Cancel" />
      <Button Grid.Column="3"
              MinWidth="86"
              Height="34"
              Padding="12,5"
              IsDefault="True"
              Click="HandleSave"
              Content="Save" />
    </Grid>
  </Grid>
</Window>
