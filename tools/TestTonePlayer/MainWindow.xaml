<Window x:Class="SpotifySynesthesia.TestTonePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TestTonePlayer"
        Width="760"
        Height="650"
        MinWidth="660"
        MinHeight="590"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="24" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="24" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="24" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="TestTonePlayer" FontFamily="Segoe UI Semibold" FontSize="28" />
          <TextBlock Margin="0,5,0,0"
                     Foreground="{StaticResource SecondaryText}"
                     FontSize="13"
                     Text="Controlled audio source for process-loopback validation" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="12,7"
                VerticalAlignment="Center"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="4">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource Accent}" />
            <TextBlock Text="{Binding PlaybackStatus}" FontFamily="Segoe UI Semibold" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2"
              Padding="22"
              Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
            <TextBlock Text="OUTPUT DEVICE" Foreground="{StaticResource SecondaryText}" FontSize="12" />
            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding OutputDevices}"
                        SelectedItem="{Binding SelectedOutputDevice}"
                        DisplayMemberPath="DisplayName" />
              <Button Grid.Column="2"
                      Content="Refresh"
                      Command="{Binding RefreshDevicesCommand}" />
            </Grid>
          </StackPanel>

          <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBlock Text="SIGNAL" Foreground="{StaticResource SecondaryText}" FontSize="12" />
            <ComboBox Margin="0,7,0,0"
                      ItemsSource="{Binding Signals}"
                      SelectedItem="{Binding SelectedSignal}"
                      DisplayMemberPath="DisplayName" />
          </StackPanel>

          <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Text="CHANNELS" Foreground="{StaticResource SecondaryText}" FontSize="12" />
            <ComboBox Margin="0,7,0,0"
                      ItemsSource="{Binding Channels}"
                      SelectedItem="{Binding SelectedChannel}"
                      DisplayMemberPath="DisplayName" />
          </StackPanel>

          <Grid Grid.Row="4" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="LEVEL" Foreground="{StaticResource SecondaryText}" FontSize="12" />
            <TextBlock Grid.Column="1" Text="{Binding VolumeDisplay}" FontFamily="Segoe UI Semibold" />
            <Slider Grid.ColumnSpan="2"
                    Margin="0,25,0,0"
                    Minimum="0"
                    Maximum="50"
                    TickFrequency="5"
                    IsSnapToTickEnabled="False"
                    Value="{Binding VolumePercent, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>

          <Button Grid.Row="6"
                  Grid.ColumnSpan="3"
                  Height="52"
                  Background="{StaticResource Accent}"
                  BorderBrush="{StaticResource Accent}"
                  Foreground="#101412"
                  Content="{Binding ToggleButtonLabel}"
                  Command="{Binding TogglePlaybackCommand}" />
        </Grid>
      </Border>

      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="14" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
          <TextBlock Text="ACTIVE SIGNAL" Foreground="{StaticResource SecondaryText}" FontSize="11" />
          <TextBlock Margin="0,5,0,0" Text="{Binding ActiveSignal}" FontFamily="Segoe UI Semibold" FontSize="14" />
        </StackPanel>
        <Border Grid.RowSpan="3" Grid.Column="1" Background="{StaticResource PanelBorder}" />
        <StackPanel Grid.Row="0" Grid.Column="2" Margin="22,0,0,0">
          <TextBlock Text="SAMPLE RATE" Foreground="{StaticResource SecondaryText}" FontSize="11" />
          <TextBlock Margin="0,5,0,0" Text="{Binding SampleRate}" FontFamily="Segoe UI Semibold" FontSize="14" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0">
          <TextBlock Text="PROCESS ID" Foreground="{StaticResource SecondaryText}" FontSize="11" />
          <TextBlock Margin="0,5,0,0" Text="{Binding ProcessId}" FontFamily="Consolas" FontSize="14" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Margin="22,0,0,0">
          <TextBlock Text="ACTIVE OUTPUT" Foreground="{StaticResource SecondaryText}" FontSize="11" />
          <TextBlock Margin="0,5,0,0"
                     Text="{Binding ActiveOutputDevice}"
                     TextTrimming="CharacterEllipsis"
                     FontFamily="Segoe UI Semibold"
                     FontSize="14" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="6"
              MinHeight="42"
              Padding="12,10"
              Background="#2A2117"
              BorderBrush="{StaticResource Warning}"
              BorderThickness="1"
              CornerRadius="4">
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#FFD79A"
                   TextWrapping="Wrap" />
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
