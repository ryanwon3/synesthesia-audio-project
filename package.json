{
  "name": "synesthesia-cloud",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:cloud": "vitest run --config cloud/vitest.config.ts",
    "typecheck:cloud": "tsc --project cloud/tsconfig.json --noEmit",
    "build": "npm run typecheck:cloud && npm --prefix visualizer run build",
    "build:hosted": "npm run typecheck:cloud && npm --prefix visualizer run build -- --mode hosted",
    "migrate:cloud": "tsx cloud/src/migrate.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "4.1.10"
  }
}
